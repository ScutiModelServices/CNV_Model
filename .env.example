# Copy to .env.local (run.bat), .env.compose (docker compose --env-file) or .env (Deploy). Git-ignored.
# Ollama address, GGUF folder, parallelism, caches and thinking are set on the admin page, not here.

# Empty = no auth (local use only)
SERVICE_ADMIN_PASSWORD=
SERVICE_PORT=29204

# Local run only: address to bind
# SERVICE_HOST=127.0.0.1

# Compose only
SERVICE_REPLICAS=1
# SERVICE_MEM_LIMIT=7g
# Host folder for downloaded GGUF files; empty = the named volume
# SERVICE_MODELS_PATH=
