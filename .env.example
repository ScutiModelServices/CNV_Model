# Copy to .env.local (run on this device with run.bat), .env.compose (Docker Desktop here: docker compose --env-file .env.compose) or .env (the file Deploy pushes to the deployment device). All git-ignored; .env.local beats .env.

# Empty = no auth (local use only).
SERVICE_ADMIN_PASSWORD=
SERVICE_PORT=29204

# Compose only
SERVICE_REPLICAS=1
# SERVICE_HOST=127.0.0.1
# SERVICE_MEM_LIMIT=7g

# First-start values only. The admin page's Settings card (saved in the data volume) overrides them live:
# Ollama address, GGUF folder and parallel generations. Start Ollama, then download weights from /admin/ → Models and builds.
SERVICE_OLLAMA_URL=http://host.docker.internal:11434
# llamacpp models only: the folder of GGUF files shared with their sidecars (the sidecar address is `url` in the model's catalog file).
# SERVICE_MODELS_DIR=models
SERVICE_OLLAMA_PARALLEL=2